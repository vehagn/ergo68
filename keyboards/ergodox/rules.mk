# The keymap is compiled in (no VIA), as in the original ergodox_stonegarden.
MOUSEKEY_ENABLE = yes
EXTRAKEY_ENABLE = yes
NKRO_ENABLE = yes
# Keeps the ErgoDox EZ's ATmega32U4 build comfortably within its flash.
LTO_ENABLE = yes

# ErgoDox Infinity: the LCD screens (lcd.c, with fonts generated by scripts/lcd_font.py) and the
# typing speed the right half shows.
ifeq ($(strip $(KEYBOARD)), input_club/ergodox_infinity)
    SRC += lcd.c
    WPM_ENABLE = yes
endif
