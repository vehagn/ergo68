# SPDX-License-Identifier: MIT

# The left half talks to the computer and collects the right half's key presses.
if SHIELD_ERGO68_LEFT

config ZMK_KEYBOARD_NAME
    default "ergo68"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_ERGO68_LEFT || SHIELD_ERGO68_RIGHT

config ZMK_SPLIT
    default y

endif

# sekigon-gonnoc's bmp_boost board is made for ZMK (settings storage, the BLE Micro Pro bootloader)
# but doesn't say so. ZMK's build workflow then fails its board check, so say it here. Zephyr reads
# every shield's Kconfig.defconfig, so this also covers the settings_reset build.
if BOARD_BMP_BOOST

config ZMK_BOARD_COMPAT
    default y

endif
