# The left half talks to the computer and collects the right half's key presses.
if SHIELD_ERGO68_LEFT

config ZMK_KEYBOARD_NAME
    default "ergo68"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_ERGO68_LEFT || SHIELD_ERGO68_RIGHT

config ZMK_SPLIT
    default y

endif
