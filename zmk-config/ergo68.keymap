/*
 * Generated from keyboards/ergo68/keymap.c by scripts/qmk_to_zmk_keymap.py. Don't edit it by hand:
 * change keymap.c and run `just ergo68-zmk-keymap`.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp BSLH    &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp FSLH
                &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T       &kp ESC     &tog 3      &kp Y       &kp U       &kp I       &kp O       &kp P       &kp SQT
                &kp GRAVE   &kp A       &kp S       &kp D       &kp F       &kp G       &tog 1      &tog 2      &kp H       &kp J       &kp K       &kp L       &lt 1 SEMI  &kp EQUAL
                &kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B       &kp LBKT    &kp RBKT    &kp N       &kp M       &kp COMMA   &kp DOT     &kp COLON   &kp MINUS
                &kp LCTRL   &kp LGUI    &kp LALT    &kp TILDE   &kp DOLLAR  &kp BSPC    &kp DEL     &kp RET     &kp SPACE   &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &kp RALT
            >;
        };

        media {
            display-name = "MEDIA";
            bindings = <
                &bootloader   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans        &trans        &trans        &trans        &bootloader
                &none         &bt BT_CLR    &out OUT_BLE  &out OUT_USB  &none         &trans        &trans        &trans        &kp C_PREV    &kp C_MUTE    &trans        &kp C_NEXT    &trans        &trans
                &trans        &trans        &trans        &trans        &trans        &trans        &to 0         &to 0         &kp C_RW      &kp C_VOL_DN  &kp C_VOL_UP  &kp C_FF      &trans        &kp C_PP
                &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &kp C_STOP
                &none         &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        numpad {
            display-name = "NUMPAD";
            bindings = <
                &bootloader       &trans            &trans            &mkp MB4          &mkp MB5          &trans            &trans            &kp KP_NUM        &kp KP_SLASH      &kp KP_MULTIPLY   &kp KP_MINUS      &bootloader
                &trans            &none             &kp C_AC_BACK     &mkp LCLK         &mkp RCLK         &kp C_AC_FORWARD  &trans            &trans            &kp LPAR          &kp KP_N7         &kp KP_N8         &kp KP_N9         &kp KP_PLUS       &none
                &trans            &none             &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_UP      &mmv MOVE_RIGHT   &to 0             &to 0             &kp RPAR          &kp KP_N4         &kp KP_N5         &kp KP_N6         &kp KP_DOT        &trans
                &trans            &none             &msc SCRL_LEFT    &msc SCRL_DOWN    &msc SCRL_UP      &msc SCRL_RIGHT   &mkp MCLK         &trans            &kp KP_N0         &kp KP_N1         &kp KP_N2         &kp KP_N3         &kp KP_COMMA      &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &kp KP_N0         &trans            &trans            &trans            &trans            &trans
            >;
        };

        func {
            display-name = "FUNC";
            bindings = <
                &bootloader          &kp F1               &kp F2               &kp F3               &kp F4               &kp F5               &kp F6               &kp F7               &kp F8               &kp F9               &kp F10              &kp F11
                &none                &trans               &trans               &trans               &trans               &trans               &trans               &to 0                &kp INS              &kp HOME             &kp PG_UP            &trans               &kp PSCRN            &kp F12
                &trans               &trans               &trans               &trans               &trans               &trans               &to 0                &to 0                &kp DEL              &kp END              &kp PG_DN            &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &kp LS(INS)          &trans               &trans               &trans               &trans               &trans               &trans               &kp RGUI             &kp RSHFT
                &trans               &trans               &trans               &mt LC(LALT) K_MENU  &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &trans               &kp RCTRL
            >;
        };
    };
};
