# Build environment for every firmware in this repo.
#
# Ubuntu 24.04 rather than QMK's own qmk_cli image: the BLE Micro Pro firmware only starts when it's
# built with Ubuntu 24.04's gcc-arm-none-eabi (GCC 13.2.1), the compiler sekigon builds the official
# releases with. Built with the GCC 15 in QMK's image (or Arm's own 10.3 to 14.2 releases), the
# bootloader accepts it but it never starts. These are the packages QMK's own install script uses on
# Debian and Ubuntu, so mainline QMK builds the same way.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git make just sudo unzip zip \
        python3 python3-venv python3-pip \
        gcc-arm-none-eabi binutils-arm-none-eabi libnewlib-arm-none-eabi \
        gcc-avr binutils-avr avr-libc avrdude \
        dfu-util dfu-programmer teensy-loader-cli \
    && rm -rf /var/lib/apt/lists/*

# The qmk CLI, in its own virtualenv (Ubuntu doesn't allow pip installs into the system Python).
RUN python3 -m venv /opt/qmk \
    && /opt/qmk/bin/pip install --no-cache-dir qmk
ENV PATH=/opt/qmk/bin:$PATH

# ZMK (Ergo68 on BMP Boosts): the same toolchain as ZMK's own build image for its Zephyr version
# (zmkfirmware/zmk-docker, branch 4.1-branch): Zephyr 4.1.0's Python requirements, CMake 3.31.6 and
# Zephyr SDK 0.16.9 with only the Arm toolchain. Keep ZEPHYR_VERSION in step with the zephyr revision
# in ZMK's app/west.yml at the commit pinned in zmk-config/west.yml.
ARG ZEPHYR_VERSION=4.1.0
ARG ZEPHYR_SDK_VERSION=0.16.9
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ccache device-tree-compiler file g++ gcc gperf ninja-build protobuf-compiler python3-dev xz-utils \
    && rm -rf /var/lib/apt/lists/*

# West, Zephyr's Python requirements and CMake, in a virtualenv of their own. It isn't on PATH, so its
# python3 doesn't shadow the qmk CLI's; `just ergo68-zmk` puts it first while it builds.
RUN python3 -m venv /opt/zephyr \
    && /opt/zephyr/bin/pip install --no-cache-dir \
        -r "https://raw.githubusercontent.com/zephyrproject-rtos/zephyr/v${ZEPHYR_VERSION}/scripts/requirements-base.txt" \
        west cmake==3.31.6 "protobuf~=5.29" grpcio-tools

# The minimal SDK plus its Arm toolchain, checked against the release's sha256.sum.
RUN set -eu; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64)  sdk_sha=b433f19b334cd15f4d7696a958dda214a7737cf41432900d076adce4253782a5; \
                 arm_sha=81162a8326e3cb82fcc53f20528aa7abec29a0bf8376fa009e0c887ba864aaf8 ;; \
        aarch64) sdk_sha=e6b1f22a9727c4e5322676d9c18d95f7bd881218795f9e08ca4ef25e8f5d1551; \
                 arm_sha=f21b0c5b45cd05c5cd7cb46fcf5ae27a0eeca73c18633706b790708110893ba0 ;; \
        *) echo "no Zephyr SDK for $arch" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/zephyrproject-rtos/sdk-ng/releases/download/v${ZEPHYR_SDK_VERSION}"; \
    cd /tmp; \
    curl -fsSLo sdk.tar.xz "$url/zephyr-sdk-${ZEPHYR_SDK_VERSION}_linux-${arch}_minimal.tar.xz"; \
    curl -fsSLo arm.tar.xz "$url/toolchain_linux-${arch}_arm-zephyr-eabi.tar.xz"; \
    printf '%s  sdk.tar.xz\n%s  arm.tar.xz\n' "$sdk_sha" "$arm_sha" | sha256sum -c -; \
    tar -xJf sdk.tar.xz -C /opt; \
    tar -xJf arm.tar.xz -C "/opt/zephyr-sdk-${ZEPHYR_SDK_VERSION}"; \
    rm sdk.tar.xz arm.tar.xz
ENV ZEPHYR_SDK_INSTALL_DIR=/opt/zephyr-sdk-${ZEPHYR_SDK_VERSION} \
    ZEPHYR_TOOLCHAIN_VARIANT=zephyr

# The DejaVu fonts and Pillow, for scripts/lcd_font.py (the ErgoDox Infinity's LCD fonts), and a host
# C compiler (gcc, above) for its LCD previews.
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core python3-pil \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for VS Code; Dev Containers changes its UID/GID to match yours. Ubuntu's image
# already has a user with UID 1000, which would take the UID Dev Containers wants to give vscode.
RUN userdel --remove ubuntu 2>/dev/null; \
    useradd --create-home --shell /bin/bash --user-group vscode \
    && echo 'vscode ALL=(root) NOPASSWD:ALL' > /etc/sudoers.d/vscode \
    && chmod 0440 /etc/sudoers.d/vscode
